<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.photo.booking.mapper.PackageMapper">
    
    <resultMap id="PackageResultMap" type="com.photo.booking.entity.Package">
        <id column="id" property="id" />
        <result column="photographer_id" property="photographerId" />
        <result column="name" property="name" />
        <result column="price" property="price" />
        <result column="description" property="description" />
        <result column="features" property="features" />
        <result column="status" property="status" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>
    
    <select id="getPackagesByPhotographerId" resultMap="PackageResultMap">
        SELECT * FROM package WHERE photographer_id = #{photographerId} AND status = 1
        ORDER BY create_time DESC
    </select>
    
    <select id="getPackageById" resultMap="PackageResultMap">
        SELECT * FROM package WHERE id = #{id}
    </select>
    
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO package (photographer_id, name, price, description, features, status, create_time, update_time)
        VALUES (#{photographerId}, #{name}, #{price}, #{description}, #{features}, #{status}, NOW(), NOW())
    </insert>
    
    <update id="update">
        UPDATE package SET
            name = #{name},
            price = #{price},
            description = #{description},
            features = #{features},
            status = #{status},
            update_time = NOW()
        WHERE id = #{id}
    </update>
    
    <delete id="delete">
        DELETE FROM package WHERE id = #{id}
    </delete>
</mapper>