/* app.wxss */
/* 全局样式重置 */
page, view, text, image, button, input, textarea, navigator {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif, 'PingFang SC';
  font-size: 14px;
  color: #495057;
  margin: 0;
  padding: 0;
  width: 100vw;
  height: 100vh;
  background: linear-gradient(-45deg, #A8E6CF, #D4A5FF, #F8F9FA, #A8E6CF);
  background-size: 400% 400%;
  animation: gradientFlow 12s ease infinite;
}

/* 流体渐变流动动画 */
@keyframes gradientFlow {
  0%{background-position:0% 50%}
  50%{background-position:100% 50%}
  100%{background-position:0% 50%}
}

/* 漂浮柔光光斑动画 */
.light-dot {
  position: fixed;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  filter: blur(8px);
  animation: float 8s ease-in-out infinite;
}

@keyframes float {
  0%,100% {transform: translateY(0) scale(1);}
  50% {transform: translateY(-20px) scale(1.1);}
}

/* 呼吸按钮动画 */
.breathe {
  animation: breathe 4s ease-in-out infinite;
}

@keyframes breathe {
  0%,100% {transform: scale(1);}
  50% {transform: scale(1.03);}
}

/* 透明发光输入框 */
.input-box {
  width: 80vw;
  height: 44px;
  background: transparent;
  border: 1px solid rgba(255,255,255,0.35);
  border-radius: 16px;
  padding: 0 16px;
  color: #fff;
}

.input-box:focus {
  border-color: #A8E6CF;
  box-shadow: 0 0 12px rgba(168,230,207,0.4);
}

.container {
  width: 100%;
  min-height: 100vh;
  padding: 0 16rpx;
}

/* 按钮样式 */
.btn {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 16rpx;
  font-size: 14px;
  text-align: center;
  transition: all 0.3s ease;
}

.btn-primary {
  background: linear-gradient(90deg, #A8E6CF 0%, #D4A5FF 100%);
  color: #fff;
  box-shadow: 0 4px 20px 0 rgba(31, 38, 135, 0.05);
}

.btn-secondary {
  background-color: #FFFFFF;
  color: #495057;
  border: 1rpx solid #F1F3F5;
}

.btn-heart {
  background-color: #FFB5A7;
  color: #fff;
}

/* 卡片样式 */
.card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4px 20px 0 rgba(31, 38, 135, 0.05);
}

/* 图片样式 */
.img {
  width: 100%;
  height: auto;
  border-radius: 16rpx;
}

/* 文字样式 */
.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.text-muted {
  color: #868E96;
}

.text-primary {
  color: #495057;
}

.text-title {
  color: #212529;
}

.text-heart {
  color: #FFB5A7;
}

.text-success {
  color: #9ED9CC;
}

.text-warning {
  color: #FFD6A5;
}

.text-danger {
  color: #FF8A80;
}

/* 字体大小 */
.text-lg {
  font-size: 32rpx;
  font-weight: 600;
}

.text-md {
  font-size: 28rpx;
  font-weight: 600;
}

.text-sm {
  font-size: 24rpx;
}

.text-xs {
  font-size: 20rpx;
}

/* 间距样式 */
.mt-1 {
  margin-top: 8rpx;
}

.mt-2 {
  margin-top: 16rpx;
}

.mt-3 {
  margin-top: 24rpx;
}

.mt-4 {
  margin-top: 32rpx;
}

.mb-1 {
  margin-bottom: 8rpx;
}

.mb-2 {
  margin-bottom: 16rpx;
}

.mb-3 {
  margin-bottom: 24rpx;
}

.mb-4 {
  margin-bottom: 32rpx;
}

/* 表单样式 */
.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  margin-bottom: 8rpx;
  font-weight: 500;
  color: #212529;
}

.form-input {
  width: 100%;
  padding: 12rpx;
  border: 1rpx solid #F1F3F5;
  border-radius: 16rpx;
  font-size: 14px;
  background-color: #F8F9FA;
  transition: all 0.3s ease;
}

/* 加载样式 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx;
}

.loading-text {
  font-size: 24rpx;
  color: #868E96;
  margin-left: 16rpx;
}

/* 空状态样式 */
.empty {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 64rpx 0;
  color: #868E96;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 24rpx;
}

/* 毛玻璃效果 */
.glass {
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

/* 响应式 */
@media (max-width: 375px) {
  .container {
    padding: 0 12rpx;
  }
}

/* 时间选择器样式 */
picker {
  font-size: 18px;
}

picker-view {
  font-size: 18px;
}

picker-view-column {
  font-size: 18px;
}

picker-view .wx-picker-view-column__item {
  font-size: 18px;
}

/* 日期选择器样式 */
picker.mode-date {
  font-size: 18px;
}

/* 时间选择器样式 */
picker.mode-time {
  font-size: 18px;
}
