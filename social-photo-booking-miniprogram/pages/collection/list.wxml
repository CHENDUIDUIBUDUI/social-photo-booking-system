<!-- 我的收藏页面 -->
<view class="container">
  <view class="header">
    <view class="header-left" bindtap="navigateBack">
      <text class="header-back">←</text>
    </view>
    <view class="header-title">我的收藏</view>
    <view class="header-right"></view>
  </view>
  
  <view class="content">
    <view wx:if="{{collectionList.length === 0}}">
      <view class="empty-container">
        <image class="empty-image" src="https://picsum.photos/200/200?random=3"></image>
        <text class="empty-text">暂无收藏</text>
      </view>
    </view>
    
    <view wx:else class="collection-list">
      <view wx:for="{{collectionList}}" wx:key="{{item.id}}" class="collection-item" bindtap="navigateToDetail" data-id="{{item.id}}">
        <image class="collection-image" src="{{item.imageUrl}}"></image>
        <view class="collection-info">
          <text class="collection-title">{{item.title}}</text>
          <text class="collection-description">{{item.description}}</text>
          <view class="collection-meta">
            <view class="collection-author">
              <image class="author-avatar" src="{{item.authorAvatar}}"></image>
              <text class="author-name">{{item.author}}</text>
            </view>
            <view class="collection-stats">
              <view class="stat-item">
                <text class="stat-icon">❤️</text>
                <text class="stat-text">{{item.likes}}</text>
              </view>
              <view class="stat-item">
                <text class="stat-icon">💬</text>
                <text class="stat-text">{{item.comments}}</text>
              </view>
            </view>
          </view>
        </view>
        <view class="collection-action" bindtap="cancelCollection" data-id="{{item.id}}">
          <text class="action-icon">★</text>
        </view>
      </view>
    </view>
  </view>
  
  <view class="loading" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>
</view>