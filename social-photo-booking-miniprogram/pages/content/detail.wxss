/* 作品详情页 - 轻透氛围感极简风 */

/* 配色变量 */
:root {
  --mint-green: #A8E6CF;
  --lavender: #DDA0DD;
  --soft-pink: #FFB6C1;
  --glass-bg: rgba(255, 255, 255, 0.85);
  --glass-border: rgba(255, 255, 255, 0.3);
  --heart-color: #FF6B9D;
}

page {
  background: linear-gradient(180deg, #f0f9f4 0%, #faf5fa 100%);
  min-height: 100vh;
}

.container {
  padding-bottom: 120rpx;
}

/* 顶部导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  padding-top: var(--status-bar-height, 44rpx);
  z-index: 100;
  background: transparent;
  transition: all 0.3s ease;
}

.nav-bar.scrolled {
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 2rpx 20rpx rgba(0, 0, 0, 0.05);
}

.back-btn, .more-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.back-btn .iconfont,
.more-btn .iconfont {
  font-size: 32rpx;
  color: #333;
}

.page-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.page-title.show {
  opacity: 1;
}

/* 作品大图轮播 */
.image-swiper {
  width: 100%;
  height: 100vh;
  max-height: 1200rpx;
}

.work-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 0 0 48rpx 48rpx;
}

/* 图片计数器 */
.image-counter {
  position: absolute;
  right: 32rpx;
  top: 200rpx;
  background: rgba(0, 0, 0, 0.4);
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
}

.counter-text {
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
}

/* 作品信息区 */
.info-section {
  margin: -60rpx 24rpx 24rpx;
  padding: 40rpx 32rpx;
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 32rpx;
  border: 1rpx solid var(--glass-border);
  box-shadow: 0 8rpx 32rpx rgba(168, 230, 207, 0.15);
}

.work-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 20rpx;
  display: block;
  line-height: 1.4;
}

.work-meta {
  margin-bottom: 32rpx;
}

.publish-time {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
  display: block;
}

.shoot-params {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.param-item {
  font-size: 22rpx;
  color: #666;
  background: rgba(168, 230, 207, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

/* 作品标签 */
.work-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.tag-item {
  font-size: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #A8E6CF 0%, #DDA0DD 100%);
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  font-weight: 500;
}

/* 摄影师信息卡片 */
.photographer-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: linear-gradient(135deg, rgba(168, 230, 207, 0.1) 0%, rgba(221, 160, 221, 0.1) 100%);
  border-radius: 24rpx;
  margin-top: 24rpx;
}

.photographer-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.photographer-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  margin-right: 20rpx;
}

.photographer-detail {
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.photographer-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-right: 12rpx;
}

.verified-badge {
  width: 32rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #A8E6CF 0%, #DDA0DD 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.verified-badge .iconfont {
  font-size: 20rpx;
  color: #fff;
}

.photographer-desc {
  font-size: 24rpx;
  color: #666;
  display: block;
}

.follow-btn {
  min-width: 120rpx;
  height: 56rpx;
  line-height: 56rpx;
  background: linear-gradient(135deg, #A8E6CF 0%, #DDA0DD 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 28rpx;
  padding: 0 32rpx;
  margin: 0;
  border: none;
}

.follow-btn.following {
  background: #f0f0f0;
  color: #999;
}

/* 操作栏 */
.action-bar {
  display: flex;
  justify-content: space-around;
  padding: 32rpx 24rpx;
  margin: 0 24rpx 24rpx;
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 32rpx;
  border: 1rpx solid var(--glass-border);
  box-shadow: 0 8rpx 32rpx rgba(168, 230, 207, 0.15);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 32rpx;
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(168, 230, 207, 0.15);
  border-radius: 50%;
  margin-bottom: 12rpx;
  transition: all 0.3s ease;
}

.action-icon .iconfont,
.action-icon icon {
  font-size: 40rpx;
  color: #666;
  transition: all 0.3s ease;
}

.action-icon.active {
  background: linear-gradient(135deg, #FF6B9D 0%, #FFB6C1 100%);
}

.action-icon.active .iconfont,
.action-icon.active icon {
  color: #fff;
}

.action-count {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.action-count.active {
  color: #FF6B9D;
}

/* 评论区 */
.comment-section {
  margin: 0 24rpx;
  padding: 32rpx;
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 32rpx;
  border: 1rpx solid var(--glass-border);
  box-shadow: 0 8rpx 32rpx rgba(168, 230, 207, 0.15);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-right: 12rpx;
}

.comment-count {
  font-size: 26rpx;
  color: #999;
  margin-right: auto;
}

/* 排序选项 */
.sort-options {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.sort-option {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.sort-option.active {
  color: #A8E6CF;
  background-color: rgba(168, 230, 207, 0.1);
  font-weight: 500;
}

/* 评论列表 */
.comment-list {
  margin-bottom: 24rpx;
}

.comment-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.comment-content {
  flex: 1;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.comment-nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.comment-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: block;
}

.comment-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.reply-btn {
  font-size: 24rpx;
  color: #A8E6CF;
  font-weight: 500;
}

.like-comment {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.like-comment .iconfont,
.like-comment icon {
  font-size: 28rpx;
  color: #ccc;
}

.like-comment.liked .iconfont,
.like-comment.liked icon {
  color: #FF6B9D;
}

.like-count {
  font-size: 24rpx;
  color: #999;
}

.like-comment.liked .like-count {
  color: #FF6B9D;
}

/* 空评论提示 */
.empty-comments {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 底部占位 */
.bottom-spacer {
  height: 160rpx;
}

/* 底部评论输入框 - 毛玻璃效果 */
.comment-input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  z-index: 99;
  transition: all 0.3s ease;
}

.comment-input-bar.focused {
  background: #fff;
}

.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 12rpx 20rpx;
}

.comment-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  font-size: 28rpx;
  color: #333;
  padding: 0 16rpx;
  background: transparent;
  border: none;
  outline: none;
  z-index: 100;
  position: relative;
  -webkit-user-select: text;
  user-select: text;
  pointer-events: auto;
}

.comment-input::placeholder {
  color: #999;
}

.input-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.emoji-btn {
  font-size: 40rpx;
  padding: 8rpx;
}

.send-btn {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 32rpx;
  background: #e0e0e0;
  color: #999;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 28rpx;
  border: none;
  margin: 0;
  transition: all 0.3s ease;
}

.send-btn.active {
  background: linear-gradient(135deg, #A8E6CF 0%, #DDA0DD 100%);
  color: #fff;
}

/* 评论字数统计 */
.comment-length {
  font-size: 20rpx;
  color: #999;
  margin: 0 16rpx;
  align-self: center;
}

/* 表情选择器 */
.emoji-picker {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 199;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.emoji-picker.show {
  opacity: 1;
  visibility: visible;
}

.emoji-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 48rpx 48rpx 0 0;
  padding: 32rpx 0;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.emoji-picker.show .emoji-content {
  transform: translateY(0);
}

.emoji-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 20rpx;
  padding: 0 24rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.emoji-item {
  font-size: 40rpx;
  text-align: center;
  padding: 16rpx;
  border-radius: 8rpx;
  transition: background-color 0.2s ease;
}

.emoji-item:active {
  background-color: #f0f0f0;
}

.emoji-footer {
  text-align: center;
  padding: 24rpx;
  margin-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.emoji-cancel {
  font-size: 30rpx;
  color: #999;
}

/* 更多选项弹窗 */
.more-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.more-popup.show {
  opacity: 1;
  visibility: visible;
}

.popup-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 48rpx 48rpx 0 0;
  padding: 32rpx 0;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.more-popup.show .popup-content {
  transform: translateY(0);
}

.popup-item {
  display: flex;
  align-items: center;
  padding: 32rpx 48rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.popup-item .iconfont {
  font-size: 40rpx;
  color: #666;
  margin-right: 24rpx;
}

.popup-text {
  font-size: 30rpx;
  color: #333;
}

.popup-cancel {
  text-align: center;
  padding: 32rpx;
  font-size: 30rpx;
  color: #999;
  margin-top: 16rpx;
  border-top: 16rpx solid #f5f5f5;
}

/* 图标字体（简化版，实际项目中应使用完整图标字体） */
.iconfont {
  font-family: "iconfont";
}

/* 动画效果 */
@keyframes heartBeat {
  0%, 100% { transform: scale(1); }
  25% { transform: scale(1.2); }
  50% { transform: scale(1); }
  75% { transform: scale(1.1); }
}

.action-icon.active {
  animation: heartBeat 0.4s ease;
}
