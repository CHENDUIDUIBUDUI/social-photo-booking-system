<!-- 发现页 - 摄影师列表 -->
<wxs module="util">
  module.exports = {
    includes: function(arr, item) {
      if (!arr || arr.length === 0) return false;
      for (var i = 0; i < arr.length; i++) {
        if (arr[i] === item) return true;
      }
      return false;
    }
  }
</wxs>
<view class="container">
  <!-- 顶部搜索栏 -->
  <view class="search-bar">
    <view class="search-input">
      <text class="search-icon">🔍</text>
      <input 
        placeholder="搜索摄影师、风格、地区" 
        placeholder-class="search-placeholder"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
      />
      <text wx:if="{{searchKeyword}}" class="search-clear" bindtap="clearSearch">✕</text>
    </view>
    <text wx:if="{{searchKeyword}}" class="search-btn" bindtap="onSearchConfirm">搜索</text>
  </view>
  
  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view class="filter-item" bindtap="showFilterPanel" data-type="region">
      <text class="filter-text {{selectedFilters.region !== '全部' ? 'active' : ''}}">区域</text>
      <text class="filter-arrow">▼</text>
    </view>
    <view class="filter-item" bindtap="showFilterPanel" data-type="style">
      <text class="filter-text {{selectedFilters.styles && selectedFilters.styles.length > 0 ? 'active' : ''}}">风格</text>
      <text class="filter-arrow">▼</text>
    </view>
    <view class="filter-item" bindtap="showFilterPanel" data-type="price">
      <text class="filter-text">价格</text>
      <text class="filter-arrow">▼</text>
    </view>
    <view class="filter-item" bindtap="showFilterPanel" data-type="sort">
      <text class="filter-text {{selectedFilters.sort !== 'recommend' ? 'active' : ''}}">排序</text>
      <text class="filter-arrow">▼</text>
    </view>
  </view>
  
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <text class="loading-text">加载中...</text>
  </view>
  
  <!-- 摄影师列表 -->
  <view class="photographer-list" wx:else>
    <!-- 摄影师卡片 -->
    <view class="photographer-card" wx:for="{{photographers}}" wx:key="id" bindtap="goToPhotographerDetail" data-id="{{item.id}}">
      <!-- 头部信息 -->
      <view class="card-header">
        <view class="photographer-info">
          <image 
            class="avatar" 
            src="{{item.avatar}}" 
            binderror="handleImageError" 
            bindload="handleImageLoad" 
            data-index="{{index}}"
          />
          <view class="info">
            <view class="name-row">
              <text class="name">{{item.name}}</text>
              <view class="certification-tag" wx:if="{{item.certified}}">认证摄影师</view>
            </view>
            <view class="stats">
              <text class="stat-item">{{item.orders}}单</text>
              <text class="stat-divider">·</text>
              <text class="stat-item">{{item.rating}}%好评</text>
            </view>
          </view>
        </view>
        <button class="follow-btn" bindtap="toggleFollow" data-id="{{item.id}}" catchtap="toggleFollow">
          {{item.followed ? '已关注' : '关注'}}
        </button>
      </view>
      
      <!-- 擅长风格 -->
      <view class="style-tags">
        <view class="tag" wx:for="{{item.styles}}" wx:key="*this">
          <text class="tag-text">{{item}}</text>
        </view>
      </view>
      
      <!-- 作品缩略图 -->
      <view class="works-grid">
        <image 
          class="work-image" 
          wx:for="{{item.works}}" 
          wx:key="*this"
          src="{{item.image}}" 
          binderror="handleImageError" 
          bindload="handleImageLoad" 
          data-index="{{index}}" 
          data-work-index="{{index}}"
        />
      </view>
    </view>
    
    <!-- 空状态 -->
    <view wx:if="{{photographers.length === 0}}" class="empty-state">
      <text class="empty-text">暂无符合条件的摄影师</text>
    </view>
  </view>
  
  <!-- 筛选面板 -->
  <view class="filter-panel" wx:if="{{showFilter}}">
    <view class="filter-panel-content">
      <view class="filter-panel-header">
        <text class="filter-panel-title">筛选条件</text>
        <text class="filter-panel-close" bindtap="closeFilterPanel">✕</text>
      </view>
      
      <!-- 风格选择 -->
      <view class="filter-section" wx:if="{{activeFilter === '' || activeFilter === 'style'}}">
        <text class="filter-section-title">风格</text>
        <view class="tag-selector">
          <view 
            class="filter-tag {{util.includes(selectedFilters.styles, item) ? 'active' : ''}}" 
            wx:for="{{styleOptions}}" 
            wx:key="*this"
            bindtap="toggleTag" 
            data-tag="{{item}}"
          >
            <text class="filter-tag-text">{{item}}</text>
          </view>
        </view>
      </view>
      
      <!-- 价格区间 -->
      <view class="filter-section" wx:if="{{activeFilter === '' || activeFilter === 'price'}}">
        <text class="filter-section-title">价格区间</text>
        <view class="price-range">
          <text class="price-text">¥{{priceRange.min}} - ¥{{priceRange.max}}</text>
          <slider min="0" max="5000" value="{{priceRange.max}}" bindchange="priceChange" />
        </view>
      </view>
      
      <!-- 区域选择 -->
      <view class="filter-section" wx:if="{{activeFilter === '' || activeFilter === 'region'}}">
        <text class="filter-section-title">区域</text>
        <view class="region-selector">
          <view 
            class="region-item {{selectedFilters.region === item ? 'active' : ''}}" 
            wx:for="{{regionOptions}}" 
            wx:key="*this"
            bindtap="selectRegion" 
            data-region="{{item}}"
          >
            <text class="region-text">{{item}}</text>
          </view>
        </view>
      </view>
      
      <!-- 排序选项 -->
      <view class="filter-section" wx:if="{{activeFilter === '' || activeFilter === 'sort'}}">
        <text class="filter-section-title">排序</text>
        <view class="sort-options">
          <view 
            class="sort-item {{selectedFilters.sort === item.value ? 'active' : ''}}" 
            wx:for="{{sortOptions}}" 
            wx:key="*this"
            bindtap="selectSort" 
            data-sort="{{item.value}}"
          >
            <text class="sort-text">{{item.label}}</text>
          </view>
        </view>
      </view>
      
      <!-- 确认按钮 -->
      <view class="filter-panel-footer">
        <button class="confirm-btn" bindtap="confirmFilter">确认筛选</button>
      </view>
    </view>
  </view>
</view>
