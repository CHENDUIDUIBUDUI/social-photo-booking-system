/* index.wxss */
/* 全局样式 */
.container {
  background-color: #FDFDFD;
  min-height: 100vh;
  padding: 0 16px;
}

/* 顶部导航区 */
.top-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 0;
  background: #ffffff;
  position: sticky;
  top: 0;
  z-index: 100;
}

.location {
  display: flex;
  align-items: center;
}

.location-text {
  font-size: 16px;
  font-weight: 600;
  color: #212529;
  margin-right: 4px;
}

.nav-icon {
  margin-left: 16px;
  color: #495057;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  margin: 12px 0 16px 0;
  padding: 0 16px;
  height: 44px;
  background: #FFFFFF;
  border-radius: 16px;
  box-shadow: 0 4px 20px 0 rgba(31, 38, 135, 0.05);
}

.search-icon {
  color: #868E96;
  margin-right: 8px;
}

.search-input {
  flex: 1;
  font-size: 14px;
  color: #495057;
  background: transparent;
  border: none;
  outline: none;
}

.search-input::placeholder {
  color: #868E96;
}

/* Banner轮播区 */
.banner-container {
  margin-bottom: 24px;
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 4px 20px 0 rgba(31, 38, 135, 0.05);
}

.banner-swiper {
  width: 100%;
  height: 300rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 24px;
}

/* 分类标签区 */
.category-section {
  margin-bottom: 24px;
}

.category-scroll {
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 12px;
  padding-bottom: 12px;
}

.category-item {
  padding: 8px 16px;
  border-radius: 12px;
  background: #F8F9FA;
  font-size: 14px;
  color: #495057;
  font-weight: 400;
  cursor: pointer;
  transition: all 0.3s ease;
}

.category-item.active {
  background: linear-gradient(90deg, #A8E6CF 0%, #D4A5FF 100%);
  color: #FFFFFF;
  font-weight: 600;
}

/* 热门摄影师区 */
.photographer-section {
  margin-bottom: 24px;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.title-text {
  font-size: 20px;
  font-weight: 600;
  color: #212529;
}

.more-text {
  font-size: 14px;
  color: #868E96;
}

.photographer-scroll {
  white-space: nowrap;
}

.photographer-list {
  display: inline-flex;
  gap: 24px;
  padding-bottom: 12px;
}

.photographer-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.photographer-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  box-shadow: 0 4px 20px 0 rgba(31, 38, 135, 0.05);
}

.photographer-name {
  font-size: 12px;
  color: #495057;
  text-align: center;
}

/* 角色专属功能 */
.role-feature {
  margin-bottom: 24px;
}

.feature-btn {
  width: 100%;
  height: 44px;
  background: linear-gradient(90deg, #A8E6CF 0%, #D4A5FF 100%);
  color: #FFFFFF;
  font-size: 16px;
  font-weight: 600;
  border-radius: 16px;
  box-shadow: 0 4px 12px 0 rgba(168, 230, 207, 0.2);
  transition: all 0.3s ease;
}

.feature-btn::after {
  border: none;
}

.feature-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px 0 rgba(168, 230, 207, 0.3);
}

/* 推荐作品瀑布流 */
.works-section {
  margin-bottom: 24px;
}

.works-grid {
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.works-column {
  width: calc(50% - 6px);
}

.work-card {
  margin-bottom: 16px;
  background: #FFFFFF;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 4px 20px 0 rgba(31, 38, 135, 0.05);
  transition: all 0.3s ease;
}

.work-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px 0 rgba(31, 38, 135, 0.1);
}

.work-image {
  width: 100%;
  aspect-ratio: 3/4;
  object-fit: cover;
}

.work-info {
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.work-title {
  font-size: 14px;
  font-weight: 600;
  color: #212529;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.work-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.author-info {
  display: flex;
  align-items: center;
  gap: 8px;
}

.author-avatar {
  width: 24px;
  height: 24px;
  border-radius: 50%;
}

.author-name {
  font-size: 12px;
  color: #868E96;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 80px;
}

.work-stats {
  display: flex;
  align-items: center;
  gap: 4px;
}

.stats-icon {
  color: #FF8A80;
}

.stats-text {
  font-size: 12px;
  color: #868E96;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 24px 0;
  color: #868E96;
  font-size: 14px;
}

/* 底部Tabbar */
.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 56px;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-top: 1px solid #F1F3F5;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 1000;
}

.tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 8px 0;
}

.tabbar-icon {
  width: 24px;
  height: 24px;
}

.tabbar-text {
  font-size: 12px;
  color: #868E96;
}

.tabbar-item.active .tabbar-text {
  color: #212529;
  font-weight: 600;
}
