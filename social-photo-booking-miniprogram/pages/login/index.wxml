<view class="login-container">
  <!-- 漂浮柔光光斑 -->
  <view class="light-dot" style="width: 150rpx; height: 150rpx; top: 15%; left: 10%; animation-delay: 0s;"></view>
  <view class="light-dot" style="width: 200rpx; height: 200rpx; top: 50%; right: 10%; animation-delay: 2s;"></view>
  <view class="light-dot" style="width: 120rpx; height: 120rpx; top: 80%; left: 30%; animation-delay: 4s;"></view>
  <view class="light-dot" style="width: 180rpx; height: 180rpx; top: 30%; right: 25%; animation-delay: 6s;"></view>
  <view class="light-dot" style="width: 100rpx; height: 100rpx; top: 70%; left: 70%; animation-delay: 8s;"></view>
  
  <!-- 顶部Logo区域 -->
  <view class="logo-section">
    <view class="logo-icon">
      <text class="logo-icon-text">约</text>
    </view>
    <view class="logo-title">心动约拍</view>
    <view class="logo-subtitle">定格美好 一拍即合</view>
  </view>
  
  <!-- 微信登录区域 -->
  <view class="login-section">
    <view class="wechat-login-card">
      <view class="user-info-section">
        <button class="avatar-container" bindtap="getUserProfile" style="background: none; border: none; padding: 0; outline: none;">
          <image class="avatar" src="{{userInfo.avatarUrl || '../../assets/images/default-avatar.png'}}"></image>
        </button>
        <view class="user-name">{{userInfo.nickName || '点击头像登录'}}</view>
      </view>
      
      <!-- 登录按钮 -->
      <view class="login-button-section">
        <button class="login-button breathe" bindtap="wechatLogin" hover-class="login-button-hover" loading="{{loading}}">
          <text class="login-button-text">微信一键授权登录</text>
        </button>
      </view>
      
      <!-- 其他登录方式 -->
      <view class="other-login-section">
        <navigator class="other-login-link" url="/pages/phone-login/phone-login">
          <text class="other-login-text">手机号登录</text>
        </navigator>
        <navigator class="other-login-link" url="/pages/register/register">
          <text class="other-login-text">注册账号</text>
        </navigator>
      </view>
    </view>
  </view>
  
  <!-- 错误提示 -->
  <view class="error-message" wx:if="{{errorMessage}}">
    <text class="error-text">{{errorMessage}}</text>
  </view>
  
  <!-- 底部说明 -->
  <view class="bottom-section">
    <text class="bottom-text">登录即表示同意</text>
    <navigator class="bottom-link" url="/pages/agreement/privacy">
      <text class="bottom-link-text">隐私政策</text>
    </navigator>
    <text class="bottom-text">和</text>
    <navigator class="bottom-link" url="/pages/agreement/service">
      <text class="bottom-link-text">服务条款</text>
    </navigator>
  </view>
</view>