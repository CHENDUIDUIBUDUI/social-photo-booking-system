/* 消息列表页面样式 */

.container {
  min-height: 100vh;
  background-color: #f8f9fa;
}

/* 顶部标签栏 */
.tab-bar {
  display: flex;
  background-color: #fff;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(10rpx);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0 24rpx;
  position: relative;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: linear-gradient(135deg, rgba(168, 230, 207, 0.1) 0%, rgba(221, 160, 221, 0.1) 100%);
}

.tab-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #666;
  margin-bottom: 8rpx;
  transition: all 0.3s ease;
}

.tab-item.active .tab-text {
  font-weight: 600;
  color: #333;
}

.tab-underline {
  position: absolute;
  bottom: 0;
  left: 20%;
  width: 60%;
  height: 4rpx;
  background: linear-gradient(135deg, #A8E6CF 0%, #DDA0DD 100%);
  border-radius: 2rpx;
  transition: all 0.3s ease;
}

.tab-unread {
  position: absolute;
  top: 24rpx;
  right: 30%;
  width: 12rpx;
  height: 12rpx;
  background-color: #ff4d4f;
  border-radius: 50%;
  border: 2rpx solid #fff;
}

/* 内容区域 */
.content {
  min-height: calc(100vh - 100rpx);
  padding: 16rpx;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-image {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 消息列表 */
.message-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.message-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  margin-bottom: 8rpx;
  min-height: 72px;
}

.message-item:hover {
  background: linear-gradient(135deg, rgba(168, 230, 207, 0.05) 0%, rgba(221, 160, 221, 0.05) 100%);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transform: translateY(-2rpx);
}

/* 头像容器 */
.message-avatar-container {
  position: relative;
  margin-right: 16rpx;
}

.message-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  margin-right: 16rpx;
}

.system-avatar {
  background: linear-gradient(135deg, #A8E6CF 0%, #DDA0DD 100%);
  padding: 8rpx;
}

.order-avatar {
  background: linear-gradient(135deg, #A8E6CF 0%, #DDA0DD 100%);
  padding: 8rpx;
}

.unread-dot {
  position: absolute;
  top: 0;
  right: 16rpx;
  width: 16rpx;
  height: 16rpx;
  background-color: #ff4d4f;
  border-radius: 50%;
  border: 2rpx solid #fff;
}

/* 消息信息 */
.message-info {
  flex: 1;
  min-width: 0;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.message-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.system-name {
  font-weight: 600;
  color: #333;
}

.order-name {
  font-weight: 600;
  color: #ff4d4f;
}

.message-time {
  font-size: 24rpx;
  color: #999;
}

.message-content {
  font-size: 26rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  line-height: 1.4;
}

.system-content {
  color: #333;
}

.order-content {
  color: #666;
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

.loading-text {
  font-size: 24rpx;
  color: #999;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .tab-text {
    font-size: 26rpx;
  }
  
  .message-item {
    padding: 20rpx;
  }
  
  .message-avatar {
    width: 40px;
    height: 40px;
  }
  
  .message-name {
    font-size: 26rpx;
  }
  
  .message-content {
    font-size: 24rpx;
  }
}