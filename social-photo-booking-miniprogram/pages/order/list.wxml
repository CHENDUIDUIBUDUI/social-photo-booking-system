<!-- 订单列表页面 -->
<view class="container">
  <view class="header">

    <view class="header-title">{{type === 'user' ? '我的订单' : '我的预约'}}</view>
    <view class="header-right"></view>
  </view>
  
  <!-- 订单状态标签栏 -->
  <view class="status-tabs">
    <scroll-view scroll-x="true" class="status-scroll">
      <view 
        wx:for="{{statusTabs}}"
        wx:key="value"
        class="status-tab {{activeStatus === item.value ? 'active' : ''}}"
        bindtap="switchStatus" 
        data-value="{{item.value}}"
      >
        <text class="status-tab-text">{{item.label}}</text>
      </view>
    </scroll-view>
  </view>
  
  <view class="content">
    <view wx:if="{{orderList.length === 0}}">
      <view class="empty-container">
        <image class="empty-image" src="https://picsum.photos/200/200?random=1"></image>
        <text class="empty-text">{{type === 'user' ? '暂无订单' : '暂无预约'}}</text>
      </view>
    </view>
    
    <view wx:else class="order-list">
      <view wx:for="{{orderList}}" wx:key="id" class="order-item" bindtap="navigateToDetail" data-id="{{item.id}}">
        <view class="order-header">
          <text class="order-id">订单号: {{item.orderId}}</text>
          <view class="order-status" style="background: {{item.statusBgColor}}">
            <text class="order-status-text">{{item.statusText}}</text>
          </view>
        </view>
        
        <view class="order-content">
          <image class="order-image" src="{{item.imageUrl}}"></image>
          <view class="order-info">
            <text class="order-title">{{item.title}}</text>
            <text class="order-photographer">摄影师: {{item.photographerName}}</text>
            <text class="order-price">¥{{item.price}}</text>
          </view>
        </view>
        
        <view class="order-footer">
          <text class="order-time">下单时间: {{item.createTime}}</text>
          <view class="order-actions">
            <button wx:if="{{item.status === 0}}" class="order-button primary" bindtap="cancelOrder" data-id="{{item.id}}">
              取消订单
            </button>
            <button wx:if="{{item.status === 0}}" class="order-button secondary" bindtap="payOrder" data-id="{{item.id}}">
              立即付款
            </button>
            <button wx:if="{{item.status === 1}}" class="order-button secondary" bindtap="confirmOrder" data-id="{{item.id}}">
              确认订单
            </button>
            <button wx:elif="{{item.status === 2}}" class="order-button secondary" bindtap="confirmShoot" data-id="{{item.id}}">
              确认拍摄完成
            </button>
            <button wx:elif="{{item.status === 3}}" class="order-button secondary" bindtap="payBalance" data-id="{{item.id}}">
              支付尾款
            </button>
            <button wx:elif="{{item.status === 4}}" class="order-button secondary" bindtap="reviewOrder" data-id="{{item.id}}">
              评价
            </button>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <view class="loading" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>
</view>