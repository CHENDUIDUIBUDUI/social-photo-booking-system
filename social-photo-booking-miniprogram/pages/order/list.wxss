/* 订单列表页面样式 */

.container {
  min-height: 100vh;
  background-color: #f8f9fa;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  padding: 0 32rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #e9ecef;
}

.header-left {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-back {
  font-size: 40rpx;
  color: #333;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.header-right {
  width: 60rpx;
}

/* 订单状态标签栏 */
.status-tabs {
  padding: 16rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.status-scroll {
  white-space: nowrap;
  padding-bottom: 8rpx;
}

.status-tab {
  display: inline-block;
  padding: 8px 16px;
  margin-right: 12rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
  transition: all 0.3s ease;
}

.status-tab.active {
  background: linear-gradient(135deg, #A8E6CF 0%, #DDA0DD 100%);
}

.status-tab-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #666;
  transition: all 0.3s ease;
}

.status-tab.active .status-tab-text {
  color: #fff;
  font-weight: 600;
}

/* 内容区域 */
.content {
  padding: 16rpx;
  min-height: calc(100vh - 180rpx);
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-image {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 订单列表 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.order-item {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  margin-bottom: 12rpx;
}

.order-item:hover {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transform: translateY(-2rpx);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-id {
  font-size: 24rpx;
  color: #666;
}

.order-status {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  display: inline-block;
}

.order-status-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #fff;
}

/* 订单内容 */
.order-content {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.order-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  object-fit: cover;
}

.order-info {
  flex: 1;
  min-width: 0;
}

.order-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-photographer {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.order-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff4d4f;
}

/* 订单底部 */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-actions {
  display: flex;
  gap: 8px;
}

/* 订单按钮 */
.order-button {
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  min-width: 160rpx;
  text-align: center;
}

.order-button::after {
  border: none;
}

.order-button.primary {
  background: linear-gradient(135deg, #A8E6CF 0%, #DDA0DD 100%);
  color: #fff;
  border: none;
}

.order-button.secondary {
  background: linear-gradient(135deg, #A8E6CF 0%, #DDA0DD 100%);
  color: #fff;
  border: none;
}

.order-button:not(.disabled):hover {
  opacity: 0.9;
  transform: scale(1.05);
}

.order-button.disabled {
  background-color: #f0f0f0;
  color: #999;
  border: none;
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

.loading-text {
  font-size: 24rpx;
  color: #999;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .status-tab {
    padding: 6px 12px;
  }
  
  .status-tab-text {
    font-size: 24rpx;
  }
  
  .order-item {
    padding: 20rpx;
  }
  
  .order-image {
    width: 100rpx;
    height: 100rpx;
  }
  
  .order-title {
    font-size: 26rpx;
  }
  
  .order-price {
    font-size: 28rpx;
  }
  
  .order-button {
    padding: 6rpx 20rpx;
    font-size: 22rpx;
  }
}