/* 套餐创建页面样式 - 轻透氛围感极简风 */
.container {
  min-height: 100vh;
  background-color: #FDFDFD;
}

/* 表单内容 */
.form {
  padding: 24px 16px;
}

.form-item {
  background: #FFFFFF;
  border-radius: 20px;
  padding: 16px;
  margin-bottom: 16px;
  box-shadow: 0 4px 20px rgba(31, 38, 135, 0.05);
}

.form-label {
  font-size: 14px;
  color: #495057;
  margin-bottom: 12px;
  display: block;
  font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, sans-serif;
}

.form-input {
  width: 100%;
  font-size: 16px;
  color: #212529;
  padding: 12px;
  background-color: #F8F9FA;
  border: none;
  border-radius: 16px;
  font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, sans-serif;
}

.form-input:focus {
  outline: none;
  box-shadow: 0 0 0 1px linear-gradient(90deg, #A8E6CF 0%, #D4A5FF 100%);
}

.form-textarea {
  width: 100%;
  font-size: 16px;
  color: #212529;
  padding: 12px;
  background-color: #F8F9FA;
  border: none;
  border-radius: 16px;
  min-height: 120px;
  resize: none;
  font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, sans-serif;
}

.form-textarea:focus {
  outline: none;
  box-shadow: 0 0 0 1px linear-gradient(90deg, #A8E6CF 0%, #D4A5FF 100%);
}

/* 包含服务 */
.features-list {
  margin-top: 12px;
}

.feature-item {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
  background: linear-gradient(90deg, #A8E6CF26 0%, #D4A5FF26 100%);
  border-radius: 16px;
  padding: 12px;
}

.feature-input {
  flex: 1;
  font-size: 14px;
  color: #212529;
  background-color: transparent;
  border: none;
  padding: 4px 8px;
  font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, sans-serif;
}

.feature-remove {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background-color: #FF8A80;
  color: #FFFFFF;
  font-size: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12px;
  font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, sans-serif;
}

.feature-add {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  border: 2px dashed #F1F3F5;
  border-radius: 16px;
  color: #868E96;
  font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, sans-serif;
}

.add-icon {
  font-size: 20px;
  margin-right: 8px;
  color: #A8E6CF;
}

.add-text {
  font-size: 14px;
}

/* 状态 */
.status-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-text {
  font-size: 16px;
  color: #212529;
  font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, sans-serif;
}

switch {
  transform: scale(0.9);
}

/* 保存按钮 */
.submit-button {
  margin-top: 24px;
  background: linear-gradient(90deg, #A8E6CF 0%, #D4A5FF 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 16px;
  padding: 14px;
  font-size: 16px;
  font-weight: 600;
  font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, sans-serif;
  width: 100%;
  box-shadow: 0 4px 12px rgba(168, 230, 207, 0.2);
  min-height: 44px;
}