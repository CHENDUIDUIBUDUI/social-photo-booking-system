/* 登录页面样式 */
.login-container {
  position: relative;
  height: 100vh;
  background: linear-gradient(135deg, #D4A5FF 0%, #9370DB 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 40rpx;
  overflow: hidden;
}

/* 漂浮柔光光斑 */
.light-dot {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  animation: float 10s ease-in-out infinite;
  box-shadow: 0 0 100rpx 100rpx rgba(255, 255, 255, 0.1);
}

@keyframes float {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-20px) scale(1.1);
  }
}

/* 标题区域 */
.title-section {
  margin-top: 120rpx;
  text-align: center;
  margin-bottom: 80rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.2);
}

/* 表单区域 */
.form-section {
  width: 100%;
  max-width: 600rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(10rpx);
}

/* 表单项 */
.form-item {
  margin-bottom: 30rpx;
  position: relative;
}

.input-box {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: white;
  transition: all 0.3s ease;
}

.input-box:focus {
  border-color: #9370DB;
  box-shadow: 0 0 0 4rpx rgba(147, 112, 219, 0.1);
}

/* 密码输入框样式 */
.password-item {
  display: flex;
  align-items: center;
}

.password-item .input-box {
  padding-right: 120rpx;
}

.eye-icon {
  position: absolute;
  right: 24rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  transition: all 0.3s ease;
}

.eye-icon text {
  font-size: 40rpx;
}

.eye-icon:active {
  transform: scale(0.95);
}

/* 登录按钮 */
.login-button-section {
  margin-top: 40rpx;
  margin-bottom: 30rpx;
}

.login-button {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #9370DB 0%, #6A5ACD 100%);
  border: none;
  border-radius: 12rpx;
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.login-button::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(
    to right,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.3) 50%,
    rgba(255, 255, 255, 0) 100%
  );
  transform: rotate(45deg);
  animation: shine 3s infinite;
}

@keyframes shine {
  0% {
    transform: translateX(-100%) rotate(45deg);
  }
  100% {
    transform: translateX(100%) rotate(45deg);
  }
}

.login-button:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 5rpx 20rpx rgba(147, 112, 219, 0.4);
}

.login-button:active {
  transform: translateY(0);
}

.login-button-text {
  position: relative;
  z-index: 1;
}

/* 注册链接 */
.register-section {
  text-align: center;
}

.register-link {
  text-decoration: none;
}

.register-text {
  font-size: 24rpx;
  color: #666;
}

/* 错误提示 */
.error-message {
  margin-top: 30rpx;
  padding: 15rpx 20rpx;
  background: rgba(255, 70, 70, 0.1);
  border-left: 4rpx solid #FF4646;
  border-radius: 8rpx;
  width: 100%;
  max-width: 600rpx;
}

.error-text {
  font-size: 24rpx;
  color: #FF4646;
}

/* 底部说明 */
.bottom-section {
  margin-top: auto;
  margin-bottom: 40rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}

.bottom-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  margin: 0 10rpx;
}

.bottom-link {
  text-decoration: none;
  margin: 0 10rpx;
}

.bottom-link-text {
  font-size: 20rpx;
  color: white;
  text-decoration: underline;
}

/* 呼吸动画 */
.breathe {
  animation: breathe 3s ease-in-out infinite;
}

@keyframes breathe {
  0%, 100% {
    box-shadow: 0 0 20rpx rgba(147, 112, 219, 0.3);
  }
  50% {
    box-shadow: 0 0 40rpx rgba(147, 112, 219, 0.6);
  }
}