<view class="apply-container">
  <view class="light-dot" style="width: 150rpx; height: 150rpx; top: 15%; left: 10%; animation-delay: 0s;"></view>
  <view class="light-dot" style="width: 200rpx; height: 200rpx; top: 50%; right: 10%; animation-delay: 2s;"></view>
  <view class="light-dot" style="width: 120rpx; height: 120rpx; top: 80%; left: 30%; animation-delay: 4s;"></view>
  <view class="light-dot" style="width: 180rpx; height: 180rpx; top: 30%; right: 25%; animation-delay: 6s;"></view>
  <view class="light-dot" style="width: 100rpx; height: 100rpx; top: 70%; left: 70%; animation-delay: 8s;"></view>
  
  <view class="header">
    <text class="title">申请成为摄影师</text>
    <text class="subtitle">填写以下信息，开启您的摄影师之旅</text>
  </view>

  <view class="form-section">
    <view class="form-title">基本信息</view>
    
    <view class="form-item">
      <text class="label">真实姓名</text>
      <input class="input" placeholder="请输入真实姓名" value="{{formData.realName}}" bindinput="onRealNameInput" />
    </view>

    <view class="form-item">
      <text class="label">身份证号</text>
      <input class="input" placeholder="请输入身份证号" value="{{formData.idCard}}" bindinput="onIdCardInput" maxlength="18" />
    </view>

    <view class="form-item">
      <text class="label">手机号码</text>
      <input class="input" placeholder="请输入手机号码" value="{{formData.phone}}" bindinput="onPhoneInput" maxlength="11" />
    </view>

    <view class="form-item">
      <text class="label">所在城市</text>
      <input class="input" placeholder="请输入所在城市" value="{{formData.region}}" bindinput="onRegionInput" />
    </view>

    <view class="form-item">
      <text class="label">个人简介</text>
      <textarea class="textarea" placeholder="请简要介绍您的摄影经历和特长" value="{{formData.bio}}" bindinput="onBioInput" maxlength="500" />
      <text class="char-count">{{formData.bio.length}}/500</text>
    </view>
  </view>

  <view class="form-section">
    <view class="form-title">证件照片</view>
    
    <view class="upload-section">
      <view class="upload-item">
        <text class="upload-label">身份证正面</text>
        <view class="upload-box" bindtap="chooseIdCardFront">
          <image wx:if="{{formData.idCardFront}}" src="{{formData.idCardFront}}" class="upload-image" mode="aspectFill" />
          <view wx:else class="upload-placeholder">
            <text class="upload-icon">📷</text>
            <text class="upload-text">点击上传</text>
          </view>
        </view>
      </view>

      <view class="upload-item">
        <text class="upload-label">身份证反面</text>
        <view class="upload-box" bindtap="chooseIdCardBack">
          <image wx:if="{{formData.idCardBack}}" src="{{formData.idCardBack}}" class="upload-image" mode="aspectFill" />
          <view wx:else class="upload-placeholder">
            <text class="upload-icon">📷</text>
            <text class="upload-text">点击上传</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="form-section">
    <view class="form-title">擅长风格</view>
    
    <view class="style-tags">
      <view wx:for="{{styleOptions}}" wx:key="index" 
            class="style-tag {{formData.styles.includes(item) ? 'active' : ''}}" 
            bindtap="toggleStyle" 
            data-style="{{item}}">
        <text class="tag-text">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="form-section">
    <view class="form-title">作品集</view>
    <text class="tip">请上传至少3张作品照片</text>
    
    <view class="works-grid">
      <view wx:for="{{formData.works}}" wx:key="index" class="work-item">
        <image src="{{item}}" class="work-image" mode="aspectFill" />
        <view class="delete-btn" bindtap="deleteWork" data-index="{{index}}">×</view>
      </view>
      
      <view wx:if="{{formData.works.length < 9}}" class="work-item add-btn" bindtap="chooseWork">
        <text class="add-icon">+</text>
        <text class="add-text">添加作品</text>
      </view>
    </view>
    <text class="work-count">{{formData.works.length}}/9</text>
  </view>

  <view class="form-section">
    <view class="form-title">起拍价格</view>
    <view class="price-input">
      <text class="currency">¥</text>
      <input class="price-number" type="digit" placeholder="0" value="{{formData.price}}" bindinput="onPriceInput" />
      <text class="unit">元起</text>
    </view>
  </view>

  <view class="agreement-section">
    <view class="agreement-item" bindtap="toggleAgreement">
      <view class="checkbox {{formData.agreed ? 'checked' : ''}}">
        <text wx:if="{{formData.agreed}}" class="check-icon">✓</text>
      </view>
      <text class="agreement-text">我已阅读并同意</text>
      <text class="agreement-link">《摄影师入驻协议》</text>
    </view>
  </view>

  <view class="submit-section">
    <button class="submit-btn" bindtap="submitApplication" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '提交申请'}}
    </button>
  </view>

  <view class="notice-section">
    <text class="notice-title">温馨提示</text>
    <text class="notice-text">1. 提交申请后，我们会在1-3个工作日内完成审核</text>
    <text class="notice-text">2. 审核通过后，您将收到系统通知</text>
    <text class="notice-text">3. 如有疑问，请联系客服</text>
  </view>
</view>