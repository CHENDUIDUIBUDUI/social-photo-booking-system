.apply-container {
  width: 100%;
  min-height: 100vh;
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
  background: linear-gradient(180deg, #A8E6CF 0%, #D4A5FF 50%, #667eea 100%);
}

.header {
  text-align: center;
  padding: 80rpx 0 60rpx;
  z-index: 2;
}

.title {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 2rpx;
}

.form-section {
  width: 100%;
  margin-bottom: 40rpx;
  z-index: 2;
}

.form-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 32rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  letter-spacing: 2rpx;
  padding-left: 20rpx;
  border-left: 6rpx solid #A8E6CF;
}

.form-item {
  margin-bottom: 32rpx;
  position: relative;
}

.label {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  letter-spacing: 2rpx;
}

.input {
  width: 100%;
  height: 100rpx;
  background: transparent;
  border: 2rpx solid rgba(0, 0, 0, 0.35);
  border-radius: 20rpx;
  padding: 0 32rpx;
  color: #000 !important;
  font-size: 36rpx;
  font-weight: 500;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  letter-spacing: 2rpx;
  box-sizing: border-box;
}

.input:focus {
  border-color: #A8E6CF;
  box-shadow: 0 0 24rpx rgba(168, 230, 207, 0.4);
  transform: translateY(-2rpx);
}

.input::placeholder {
  color: rgba(0, 0, 0, 0.6);
  font-size: 32rpx;
  font-weight: 400;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  background: transparent;
  border: 2rpx solid rgba(0, 0, 0, 0.35);
  border-radius: 20rpx;
  padding: 20rpx 32rpx;
  color: #000 !important;
  font-size: 32rpx;
  font-weight: 500;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  letter-spacing: 2rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.textarea:focus {
  border-color: #A8E6CF;
  box-shadow: 0 0 24rpx rgba(168, 230, 207, 0.4);
  transform: translateY(-2rpx);
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

.upload-section {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.upload-item {
  flex: 1;
}

.upload-label {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  letter-spacing: 2rpx;
}

.upload-box {
  width: 100%;
  height: 400rpx;
  background: transparent;
  border: 2rpx solid rgba(0, 0, 0, 0.35);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.upload-box:active {
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.upload-text {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.6);
  font-weight: 500;
  letter-spacing: 2rpx;
}

.upload-image {
  width: 100%;
  height: 100%;
}

.style-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.style-tag {
  padding: 16rpx 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 40rpx;
  background-color: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.style-tag:active {
  transform: scale(0.95);
}

.style-tag.active {
  background: linear-gradient(90deg, #A8E6CF 0%, #D4A5FF 100%);
  border-color: transparent;
  box-shadow: 0 8rpx 32rpx rgba(212, 165, 255, 0.4);
}

.tag-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.tip {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

.works-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.work-item {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  background: transparent;
  border: 2rpx solid rgba(0, 0, 0, 0.35);
  border-radius: 16rpx;
  overflow: hidden;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.work-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 138, 128, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(255, 138, 128, 0.4);
}

.add-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed rgba(255, 255, 255, 0.5);
  background: transparent;
}

.add-icon {
  font-size: 60rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 1rpx;
}

.work-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 1rpx;
}

.price-input {
  display: flex;
  align-items: center;
  background: transparent;
  border: 2rpx solid rgba(0, 0, 0, 0.35);
  border-radius: 20rpx;
  padding: 0 32rpx;
  height: 100rpx;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.price-input:focus-within {
  border-color: #A8E6CF;
  box-shadow: 0 0 24rpx rgba(168, 230, 207, 0.4);
  transform: translateY(-2rpx);
}

.currency {
  font-size: 36rpx;
  color: #A8E6CF;
  font-weight: bold;
  margin-right: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(168, 230, 207, 0.3);
}

.price-number {
  flex: 1;
  font-size: 36rpx;
  color: #000 !important;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.unit {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.6);
  letter-spacing: 1rpx;
}

.agreement-section {
  width: 100%;
  margin-bottom: 40rpx;
  z-index: 2;
}

.agreement-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: transparent;
  border: 2rpx solid rgba(0, 0, 0, 0.35);
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.agreement-item:active {
  transform: translateY(-2rpx);
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  transition: all 0.3s ease;
}

.checkbox.checked {
  background: linear-gradient(90deg, #A8E6CF 0%, #D4A5FF 100%);
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 255, 0.4);
}

.check-icon {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

.agreement-text {
  font-size: 26rpx;
  color: #fff;
  letter-spacing: 1rpx;
}

.agreement-link {
  font-size: 26rpx;
  color: #A8E6CF;
  text-decoration: underline;
  letter-spacing: 1rpx;
}

.submit-section {
  width: 100%;
  margin-bottom: 40rpx;
  z-index: 2;
}

.submit-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(90deg, #A8E6CF 0%, #D4A5FF 100%);
  border: none;
  border-radius: 20rpx;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 48rpx rgba(212, 165, 255, 0.4);
  transition: all 0.3s ease;
  letter-spacing: 4rpx;
}

.submit-btn:active {
  transform: translateY(-4rpx);
  box-shadow: 0 16rpx 64rpx rgba(212, 165, 255, 0.5);
}

.submit-btn[disabled] {
  opacity: 0.6;
}

.notice-section {
  width: 100%;
  background: transparent;
  border: 2rpx solid rgba(0, 0, 0, 0.35);
  border-radius: 20rpx;
  padding: 30rpx;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  z-index: 2;
}

.notice-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  letter-spacing: 2rpx;
}

.notice-text {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.8;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}

/* 静态光斑装饰 */
.light-dot {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(168, 230, 207, 0.12) 0%, rgba(212, 165, 255, 0.06) 50%, transparent 100%);
  filter: blur(50rpx);
  z-index: 0;
  pointer-events: none;
}