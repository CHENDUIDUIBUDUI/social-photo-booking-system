<!-- 编辑个人信息页面 -->
<view class="container">
  <view class="header">
    <view class="header-title">编辑个人信息</view>
    <view class="header-right"></view>
  </view>
  
  <view class="content">
    <!-- 头像 -->
    <view class="form-item">
      <view class="form-label">头像</view>
      <view class="form-value">
        <image class="avatar" src="{{userInfo.avatar}}" bindtap="chooseAvatar"></image>
        <text class="upload-text">点击更换</text>
      </view>
    </view>
    
    <!-- 昵称 -->
    <view class="form-item">
      <view class="form-label">昵称</view>
      <input class="form-input" value="{{userInfo.nickname}}" bindinput="bindNicknameInput" placeholder="请输入昵称" />
    </view>
    
    <!-- 性别 -->
    <view class="form-item">
      <view class="form-label">性别</view>
      <view class="gender-select">
        <view class="gender-item {{userInfo.gender === 0 ? 'active' : ''}}" bindtap="selectGender" data-gender="0">
          <text class="gender-text">女</text>
        </view>
        <view class="gender-item {{userInfo.gender === 1 ? 'active' : ''}}" bindtap="selectGender" data-gender="1">
          <text class="gender-text">男</text>
        </view>
        <view class="gender-item {{userInfo.gender === 2 ? 'active' : ''}}" bindtap="selectGender" data-gender="2">
          <text class="gender-text">未知</text>
        </view>
      </view>
    </view>
    
    <!-- 年龄 -->
    <view class="form-item">
      <view class="form-label">年龄</view>
      <input class="form-input" value="{{userInfo.age}}" bindinput="bindAgeInput" placeholder="请输入年龄" type="number" />
    </view>
    
    <!-- 手机号 -->
    <view class="form-item">
      <view class="form-label">手机号</view>
      <view class="phone-input-container">
        <input class="form-input phone-input" value="{{userInfo.phone}}" bindinput="bindPhoneInput" placeholder="请输入手机号" type="number" />
        <button class="send-code-btn" bindtap="sendVerifyCode" disabled="{{countdown > 0}}">
          {{countdown > 0 ? countdown + 's后重新发送' : '发送验证码'}}
        </button>
      </view>
    </view>
    
    <!-- 验证码 -->
    <view class="form-item" wx:if="showVerifyCode">
      <view class="form-label">验证码</view>
      <input class="form-input" value="{{verifyCode}}" bindinput="bindVerifyCodeInput" placeholder="请输入验证码" type="number" maxlength="6" />
    </view>
    
    <!-- 简介 -->
    <view class="form-item">
      <view class="form-label">简介</view>
      <textarea class="form-textarea" value="{{userInfo.bio}}" bindinput="bindBioInput" placeholder="请输入个人简介" maxlength="200" />
    </view>
    
    <!-- 职业 -->
    <view class="form-item">
      <view class="form-label">职业</view>
      <input class="form-input" value="{{userInfo.occupation}}" bindinput="bindOccupationInput" placeholder="请输入职业" />
    </view>
    
    <!-- 技能标签 -->
    <view class="form-item">
      <view class="form-label">技能标签</view>
      <view class="tags-container">
        <view wx:for="{{userInfo.skills}}" wx:key="{{index}}" class="tag">
          <text class="tag-text">{{item}}</text>
          <text class="tag-delete" bindtap="deleteSkill" data-index="{{index}}">×</text>
        </view>
        <input class="tag-input" value="{{newSkill}}" bindinput="bindNewSkillInput" placeholder="添加技能" bindconfirm="addSkill" />
      </view>
    </view>
  </view>
  
  <view class="footer">
    <button class="save-button" bindtap="saveUserInfo" loading="{{loading}}">
      保存
    </button>
  </view>
</view>
