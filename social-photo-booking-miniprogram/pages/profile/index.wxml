<!-- 个人中心页面 -->
<view class="container">
  <!-- 顶部用户信息区 -->
  <view class="user-info-section">
    <view class="user-info-content">
      <image src="{{userInfo.avatar}}" mode="aspectFill" class="user-avatar" />
      <view class="user-details">
        <view class="user-name-row">
          <text class="user-name">{{userInfo.nickname}}</text>
        </view>
        <view class="user-role-row">
          <view wx:if="{{userInfo.role === 1}}" class="auth-badge">摄影师</view>
          <view wx:if="{{userInfo.role === 2}}" class="auth-badge">模特</view>
          <text class="user-role">{{getRoleText(userInfo.role)}}</text>
          <button class="edit-profile-btn" bindtap="navigateToEdit">
            编辑资料
          </button>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 数据栏 -->
  <view class="data-bar">
    <view class="data-item">
      <text class="data-number">{{userInfo.worksCount || 0}}</text>
      <text class="data-label">我的作品</text>
    </view>
    <view class="data-item">
      <text class="data-number">{{userInfo.fansCount || 0}}</text>
      <text class="data-label">粉丝</text>
    </view>
    <view class="data-item">
      <text class="data-number">{{userInfo.followCount || 0}}</text>
      <text class="data-label">关注</text>
    </view>
    <view class="data-item">
      <text class="data-number">{{userInfo.likeCount || 0}}</text>
      <text class="data-label">获赞</text>
    </view>
  </view>
  
  <!-- 功能菜单列表 -->
  <view class="function-list">
    <!-- 我的订单板块 -->
    <view class="function-card">
      <view class="function-item" bindtap="navigateToMyOrders">
        <view class="function-icon order-icon"></view>
        <text class="function-text">我的订单</text>
        <view class="function-arrow"></view>
      </view>
      <view class="function-item" bindtap="navigateToMyCollections">
        <view class="function-icon collection-icon"></view>
        <text class="function-text">我的收藏</text>
        <view class="function-arrow"></view>
      </view>
      <view class="function-item" bindtap="navigateToMyEvaluations">
        <view class="function-icon evaluation-icon"></view>
        <text class="function-text">我的评价</text>
        <view class="function-arrow"></view>
      </view>
    </view>
    
    <!-- 角色申请板块 -->
    <view class="function-card">
      <view class="function-item" bindtap="applyPhotographer">
        <view class="function-icon auth-icon"></view>
        <text class="function-text">申请摄影师</text>
        <view class="function-arrow"></view>
      </view>
      <view class="function-item" bindtap="applyModel">
        <view class="function-icon auth-icon"></view>
        <text class="function-text">申请模特</text>
        <view class="function-arrow"></view>
      </view>
    </view>
    
    <!-- 我的服务板块 -->
    <view class="function-card">
      <view class="function-item" bindtap="navigateToRealAuth">
        <view class="function-icon auth-icon"></view>
        <text class="function-text">实名认证</text>
        <view class="function-arrow"></view>
      </view>
      <view wx:if="{{userInfo.role == 1}}" class="function-item" bindtap="navigateToPackageManagement">
        <view class="function-icon package-icon"></view>
        <text class="function-text">套餐管理</text>
        <view class="function-arrow"></view>
      </view>
      <view class="function-item" bindtap="navigateToCreatorCenter">
        <view class="function-icon creator-icon"></view>
        <text class="function-text">创作者中心</text>
        <view class="function-arrow"></view>
      </view>
    </view>
    
    <!-- 工具与设置板块 -->
    <view class="function-card">
      <view class="function-item" bindtap="navigateToSettings">
        <view class="function-icon settings-icon"></view>
        <text class="function-text">设置</text>
        <view class="function-arrow"></view>
      </view>
      <view class="function-item" bindtap="navigateToHelp">
        <view class="function-icon help-icon"></view>
        <text class="function-text">帮助与客服</text>
        <view class="function-arrow"></view>
      </view>
      <view class="function-item" bindtap="handleLogout">
        <view class="function-icon logout-icon"></view>
        <text class="function-text logout-text">退出登录</text>
        <view class="function-arrow"></view>
      </view>
    </view>
  </view>
</view>
