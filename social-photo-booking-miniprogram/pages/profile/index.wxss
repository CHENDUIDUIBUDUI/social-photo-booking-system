/* 个人中心页面样式 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 顶部用户信息区 */
.user-info-section {
  height: 240px;
  background: linear-gradient(135deg, #A8E6CF 0%, #DDA0DD 100%);
  border-bottom-left-radius: 24px;
  border-bottom-right-radius: 24px;
  padding: 24px;
  display: flex;
  align-items: center;
  position: relative;
}

.user-info-content {
  width: 100%;
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  border: 3px solid #fff;
  margin-right: 24px;
}

.user-details {
  flex: 1;
}

.user-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8px;
}

.user-name {
  font-size: 18px;
  font-weight: 700;
  color: #fff;
}

.user-role-row {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
}

.auth-badge {
  padding: 4px 12px;
  background-color: transparent;
  color: #fff;
  font-size: 14px;
  border-radius: 0;
  margin-right: 8px;
  border: none;
}

.user-role {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.8);
}

.edit-profile-btn {
  padding: 4px 10px;
  background-color: transparent;
  border: none;
  border-radius: 0;
  color: #fff;
  font-size: 14px;
  font-weight: 500;
  transition: all 0.3s ease;
  display: inline-block;
  outline: none;
}

.edit-profile-btn::after {
  border: none;
}

.edit-profile-btn:hover {
  background-color: rgba(255, 255, 255, 0.1);
}

/* 数据栏 */
.data-bar {
  background-color: #fff;
  border-radius: 20px;
  padding: 16px;
  margin: -20px 16px 24px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.data-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.data-number {
  font-size: 18px;
  font-weight: 700;
  color: #333;
  margin-bottom: 4px;
}

.data-label {
  font-size: 12px;
  color: #999;
}

/* 功能菜单列表 */
.function-list {
  padding: 0 16px 24px;
}

.function-card {
  background-color: #fff;
  border-radius: 20px;
  margin-bottom: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.function-item {
  display: flex;
  align-items: center;
  height: 56px;
  padding: 0 16px;
  border-bottom: 1px solid #f0f0f0;
  transition: all 0.3s ease;
}

.function-item:hover {
  background-color: #f9f9f9;
}

.function-item:last-child {
  border-bottom: none;
}

.function-icon {
  width: 24px;
  height: 24px;
  margin-right: 16px;
  background: linear-gradient(135deg, #A8E6CF 0%, #DDA0DD 100%);
  border-radius: 6px;
  position: relative;
}

/* 图标样式 */
.order-icon::after {
  content: "📋";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 14px;
}

.collection-icon::after {
  content: "⭐";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 14px;
}

.evaluation-icon::after {
  content: "✏️";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 14px;
}

.auth-icon::after {
  content: "🛡️";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 14px;
}

.creator-icon::after {
  content: "🎨";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 14px;
}

.package-icon::after {
  content: "📦";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 14px;
}

.settings-icon::after {
  content: "⚙️";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 14px;
}

.help-icon::after {
  content: "❓";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 14px;
}

.logout-icon::after {
  content: "🚪";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 14px;
}

.function-text {
  flex: 1;
  font-size: 16px;
  color: #333;
}

.logout-text {
  color: #ff4757;
}

.function-arrow {
  width: 16px;
  height: 16px;
  border-top: 2px solid #999;
  border-right: 2px solid #999;
  transform: rotate(45deg);
}

