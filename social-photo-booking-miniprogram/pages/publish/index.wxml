<!-- publish/index.wxml -->
<view class="container">
  <view class="publish-options">
    <view class="option-card" bindtap="publishWork">
      <view class="option-icon">
        <text>📸</text>
      </view>
      <text class="option-text">发布作品</text>
    </view>
    <view class="option-card" bindtap="publishRequest">
      <view class="option-icon">
        <text>💡</text>
      </view>
      <text class="option-text">发布需求</text>
    </view>
  </view>
</view>