<view class="register-container">
  <!-- 漂浮柔光光斑 -->
  <view class="light-dot" style="width: 150rpx; height: 150rpx; top: 15%; left: 10%; animation-delay: 0s;"></view>
  <view class="light-dot" style="width: 200rpx; height: 200rpx; top: 50%; right: 10%; animation-delay: 2s;"></view>
  <view class="light-dot" style="width: 120rpx; height: 120rpx; top: 80%; left: 30%; animation-delay: 4s;"></view>
  <view class="light-dot" style="width: 180rpx; height: 180rpx; top: 30%; right: 25%; animation-delay: 6s;"></view>
  <view class="light-dot" style="width: 100rpx; height: 100rpx; top: 70%; left: 70%; animation-delay: 8s;"></view>
  
  <!-- 标题区域 -->
  <view class="title-section">
    <view class="title">新用户注册</view>
  </view>
  
  <!-- 注册表单 -->
  <view class="form-section">
    <!-- 手机号输入 -->
    <view class="form-item">
      <input class="input-box" type="number" placeholder="请输入手机号码" value="{{phoneNumber}}" bindinput="bindPhoneInput" maxlength="11"></input>
    </view>
    
    <!-- 密码输入 -->
    <view class="form-item password-item">
      <input class="input-box" type="text" password="{{!showPassword}}" placeholder="请输入密码" value="{{password}}" bindinput="bindPasswordInput" maxlength="20"></input>
      <view class="eye-icon" bindtap="togglePasswordVisibility">
        <text>{{showPassword ? '👁️' : '👁️‍🗨️'}}</text>
      </view>
    </view>
    
    <!-- 确认密码输入 -->
    <view class="form-item password-item">
      <input class="input-box" type="text" password="{{!showConfirmPassword}}" placeholder="请再次输入密码" value="{{confirmPassword}}" bindinput="bindConfirmPasswordInput" maxlength="20"></input>
      <view class="eye-icon" bindtap="toggleConfirmPasswordVisibility">
        <text>{{showConfirmPassword ? '👁️' : '👁️‍🗨️'}}</text>
      </view>
    </view>
    
    <!-- 昵称输入 -->
    <view class="form-item">
      <input class="input-box" type="text" placeholder="请输入昵称" value="{{nickname}}" bindinput="bindNicknameInput" maxlength="20"></input>
    </view>
    
    <!-- 摄影兴趣标签 -->
    <view class="interest-section">
      <view class="interest-title">摄影兴趣</view>
      <view class="interest-tags">
        <view class="tag-item {{selectedTags.includes('人像') ? 'active' : ''}}" bindtap="toggleTag" data-tag="人像">
          <text class="tag-text">人像</text>
        </view>
        <view class="tag-item {{selectedTags.includes('风景') ? 'active' : ''}}" bindtap="toggleTag" data-tag="风景">
          <text class="tag-text">风景</text>
        </view>
        <view class="tag-item {{selectedTags.includes('街拍') ? 'active' : ''}}" bindtap="toggleTag" data-tag="街拍">
          <text class="tag-text">街拍</text>
        </view>
        <view class="tag-item {{selectedTags.includes('时尚') ? 'active' : ''}}" bindtap="toggleTag" data-tag="时尚">
          <text class="tag-text">时尚</text>
        </view>
        <view class="tag-item {{selectedTags.includes('纪实') ? 'active' : ''}}" bindtap="toggleTag" data-tag="纪实">
          <text class="tag-text">纪实</text>
        </view>
        <view class="tag-item {{selectedTags.includes('创意') ? 'active' : ''}}" bindtap="toggleTag" data-tag="创意">
          <text class="tag-text">创意</text>
        </view>
      </view>
    </view>
    
    <!-- 注册按钮 -->
    <view class="register-button-section">
      <button class="register-button breathe" bindtap="register" hover-class="register-button-hover" loading="{{loading}}">
        <text class="register-button-text">注册</text>
      </button>
    </view>
    
    <!-- 登录链接 -->
    <view class="login-section">
      <navigator class="login-link" url="/pages/login/index">
        <text class="login-text">已有账号？微信登录</text>
      </navigator>
      <navigator class="login-link" url="/pages/phone-login/phone-login">
        <text class="login-text">手机号登录</text>
      </navigator>
    </view>
  </view>
  
  <!-- 错误提示 -->
  <view class="error-message" wx:if="{{errorMessage}}">
    <text class="error-text">{{errorMessage}}</text>
  </view>
  
  <!-- 底部说明 -->
  <view class="bottom-section">
    <text class="bottom-text">注册即表示同意</text>
    <navigator class="bottom-link" url="/pages/agreement/privacy">
      <text class="bottom-link-text">隐私政策</text>
    </navigator>
    <text class="bottom-text">和</text>
    <navigator class="bottom-link" url="/pages/agreement/service">
      <text class="bottom-link-text">服务条款</text>
    </navigator>
  </view>
</view>