.register-container {
  width: 100%;
  min-height: 100vh;
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}

/* 标题区域 */
.title-section {
  margin-bottom: 100rpx;
  z-index: 2;
  text-align: center;
  width: 100%;
}

.title {
  font-size: 64rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  letter-spacing: 4rpx;
}

/* 表单区域 */
.form-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
  flex: 1;
  justify-content: center;
  margin-bottom: 60rpx;
}

/* 表单项 */
.form-item {
  width: 100%;
  margin-bottom: 40rpx;
  position: relative;
  display: flex;
  align-items: center;
}

/* 输入框 */
.input-box {
  width: 100%;
  height: 100rpx;
  background: transparent;
  border: 2rpx solid rgba(0, 0, 0, 0.35);
  border-radius: 20rpx;
  padding: 0 32rpx;
  color: #000 !important;
  font-size: 36rpx;
  font-weight: 500;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  letter-spacing: 2rpx;
}

.input-box:focus {
  border-color: #A8E6CF;
  box-shadow: 0 0 24rpx rgba(168, 230, 207, 0.4);
  transform: translateY(-2rpx);
}

.input-box::placeholder {
  color: rgba(0, 0, 0, 0.6);
  font-size: 32rpx;
  font-weight: 400;
}

/* 密码输入框带眼睛图标 */
.password-item {
  display: flex;
  align-items: center;
}

.password-item .input-box {
  padding-right: 120rpx;
}

.eye-icon {
  position: absolute;
  right: 24rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  transition: all 0.3s ease;
}

.eye-icon text {
  font-size: 40rpx;
}

.eye-icon:active {
  transform: scale(0.95);
}

/* 摄影兴趣标签 */
.interest-section {
  width: 100%;
  margin-top: 20rpx;
  margin-bottom: 60rpx;
}

.interest-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 32rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  letter-spacing: 2rpx;
}

.interest-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.tag-item {
  padding: 16rpx 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 40rpx;
  background-color: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.tag-item:hover {
  transform: scale(1.05);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.tag-item.active {
  background: linear-gradient(90deg, #A8E6CF 0%, #D4A5FF 100%);
  border-color: transparent;
  box-shadow: 0 8rpx 32rpx rgba(212, 165, 255, 0.4);
}

.tag-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

/* 注册按钮 */
.register-button-section {
  width: 100%;
  margin-top: 20rpx;
  margin-bottom: 40rpx;
  display: flex;
  justify-content: center;
}

.register-button {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(90deg, #A8E6CF 0%, #D4A5FF 100%);
  border: none;
  border-radius: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  box-shadow: 0 12rpx 48rpx rgba(212, 165, 255, 0.4);
  transition: all 0.3s ease;
  letter-spacing: 4rpx;
}

.register-button-hover {
  transform: translateY(-4rpx);
  box-shadow: 0 16rpx 64rpx rgba(212, 165, 255, 0.5);
}

/* 登录链接 */
.login-section {
  margin-top: 20rpx;
  text-align: center;
  display: flex;
  justify-content: center;
  gap: 40rpx;
  flex-wrap: wrap;
}

.login-link {
  display: inline-block;
  padding: 16rpx 24rpx;
  border-radius: 40rpx;
  background-color: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.login-link:hover {
  background-color: rgba(255, 255, 255, 0.2);
  transform: scale(1.05);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.login-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
  transition: all 0.3s ease;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  letter-spacing: 2rpx;
}

.login-text:hover {
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

/* 错误提示 */
.error-message {
  margin-top: 32rpx;
  padding: 20rpx 28rpx;
  background-color: rgba(255, 243, 243, 0.2);
  border-radius: 16rpx;
  border-left: 6rpx solid #FF8A80;
  z-index: 2;
  width: 100%;
  text-align: center;
}

.error-text {
  font-size: 28rpx;
  color: #FF8A80;
  line-height: 1.4;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* 底部说明 */
.bottom-section {
  margin-bottom: 60rpx;
  text-align: center;
  z-index: 2;
  width: 100%;
  padding: 0 32rpx;
}

.bottom-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 400;
  letter-spacing: 1rpx;
}

.bottom-link {
  display: inline-block;
  margin: 0 12rpx;
}

.bottom-link-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
  transition: all 0.3s ease;
  letter-spacing: 1rpx;
}

.bottom-link-text:hover {
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

/* 响应式 */
@media (max-width: 375px) {
  .register-container {
    padding: 0 24rpx;
  }
  
  .back-section {
    padding-top: 40rpx;
    margin-bottom: 60rpx;
  }
  
  .back-button {
    width: 60rpx;
    height: 60rpx;
  }
  
  .back-icon {
    font-size: 32rpx;
  }
  
  .title-section {
    margin-bottom: 80rpx;
  }
  
  .title {
    font-size: 56rpx;
  }
  
  .form-item {
    margin-bottom: 32rpx;
  }
  
  .input-box {
    height: 90rpx;
    font-size: 32rpx;
    padding: 0 24rpx;
  }
  
  .input-box::placeholder {
    font-size: 28rpx;
  }
  
  .verify-code-button {
    padding: 12rpx 24rpx;
    font-size: 24rpx;
    min-width: 160rpx;
  }
  
  .interest-title {
    font-size: 32rpx;
    margin-bottom: 24rpx;
  }
  
  .tag-item {
    padding: 12rpx 24rpx;
    border-radius: 32rpx;
  }
  
  .tag-text {
    font-size: 28rpx;
  }
  
  .register-button {
    height: 90rpx;
    font-size: 32rpx;
  }
  
  .login-text {
    font-size: 28rpx;
  }
  
  .error-text {
    font-size: 24rpx;
  }
  
  .bottom-text,
  .bottom-link-text {
    font-size: 20rpx;
  }
}

/* 呼吸动画 */
@keyframes breathe {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.02);
  }
}

/* 漂浮动画 */
@keyframes float {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-30rpx) scale(1.1);
  }
}

/* 流体渐变流动动画 */
@keyframes gradientFlow {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}
