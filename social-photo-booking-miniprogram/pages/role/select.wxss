/* 角色选择页面样式 */
.role-select-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #FDFDFD;
  padding: 0 32rpx;
}

/* 顶部标题 */
.header-section {
  text-align: center;
  margin-top: 80rpx;
  margin-bottom: 80rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #212529;
  margin-bottom: 16rpx;
}

.header-subtitle {
  font-size: 24rpx;
  color: #868E96;
  line-height: 32rpx;
}

/* 角色选择卡片 */
.role-cards-section {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-bottom: 80rpx;
}

.role-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4px 20px 0 rgba(31, 38, 135, 0.05);
  transition: all 0.3s ease;
  cursor: pointer;
}

.role-card:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 8px 24px 0 rgba(31, 38, 135, 0.1);
}

.role-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 4px 12px 0 rgba(168, 230, 207, 0.2);
}

.photographer-icon {
  background: linear-gradient(135deg, #A8E6CF, #D4A5FF);
}

.model-icon {
  background: linear-gradient(135deg, #FFB5A7, #FFD6A5);
}

.user-icon {
  background: linear-gradient(135deg, #9ED9CC, #A8E6CF);
}

.icon-text {
  font-size: 60rpx;
}

.role-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #212529;
  margin-bottom: 12rpx;
  line-height: 44rpx;
}

.role-description {
  font-size: 24rpx;
  color: #868E96;
  line-height: 32rpx;
  text-align: center;
}

/* 底部说明 */
.bottom-section {
  text-align: center;
  margin-bottom: 40rpx;
}

.bottom-text {
  font-size: 20rpx;
  color: #868E96;
  line-height: 28rpx;
}

/* 加载动画 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
}

.loading-text {
  font-size: 24rpx;
  color: #868E96;
  margin-left: 16rpx;
}

/* 错误提示 */
.error-message {
  color: #FF8A80;
  font-size: 20rpx;
  margin-top: 24rpx;
  text-align: center;
  line-height: 28rpx;
}