<!-- 搜索页面 -->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-container">
    <view class="search-input-wrapper">
      <icon type="search" size="20" class="search-icon" />
      <input 
        type="text" 
        placeholder="搜索摄影师 / 风格 / 作品" 
        class="search-input" 
        value="{{keyword}}" 
        bindinput="onKeywordInput" 
        bindconfirm="search"
      />
      <text wx:if="keyword" class="clear-btn" bindtap="clearKeyword">×</text>
    </view>
    <text class="cancel-btn" bindtap="navigateBack">取消</text>
  </view>
  
  <!-- 历史搜索 -->
  <view wx:if="!isSearching && !hasResults && history.length > 0" class="history-section">
    <view class="history-header">
      <text class="history-title">历史搜索</text>
      <text class="clear-history" bindtap="clearHistory">清空</text>
    </view>
    <view class="history-list">
      <view wx:for="{{history}}" wx:key="index" class="history-item" bindtap="selectHistory" data-keyword="{{item}}">
        <text>{{item}}</text>
      </view>
    </view>
  </view>
  
  <!-- 热门搜索 -->
  <view wx:if="!isSearching && !hasResults" class="hot-section">
    <text class="hot-title">热门搜索</text>
    <view class="hot-list">
      <view wx:for="{{hotKeywords}}" wx:key="index" class="hot-item" bindtap="selectHotKeyword" data-keyword="{{item}}">
        <text>{{item}}</text>
      </view>
    </view>
  </view>
  
  <!-- 搜索中 -->
  <view wx:if="isSearching" class="loading-section">
    <text>搜索中...</text>
  </view>
  
  <!-- 搜索结果 -->
  <view wx:if="hasResults" class="results-section">
    <!-- 摄影师结果 -->
    <view wx:if="photographers.length > 0" class="result-group">
      <text class="result-title">摄影师</text>
      <view class="photographer-list">
        <view wx:for="{{photographers}}" wx:key="id" class="photographer-item" bindtap="navigateToPhotographer" data-id="{{item.id}}">
          <image src="{{item.avatar}}" mode="aspectFill" class="photographer-avatar" />
          <view class="photographer-info">
            <text class="photographer-name">{{item.name}}</text>
            <text class="photographer-specialty">{{item.specialty}}</text>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 作品结果 -->
    <view wx:if="works.length > 0" class="result-group">
      <text class="result-title">作品</text>
      <view class="works-grid">
        <view wx:for="{{works}}" wx:key="id" class="work-item" bindtap="navigateToWork" data-id="{{item.id}}">
          <image src="{{item.imageUrl}}" mode="aspectFill" class="work-image" />
          <text class="work-title">{{item.title}}</text>
        </view>
      </view>
    </view>
    
    <!-- 无结果 -->
    <view wx:if="photographers.length === 0 && works.length === 0" class="no-results">
      <text>未找到相关内容</text>
    </view>
  </view>
</view>