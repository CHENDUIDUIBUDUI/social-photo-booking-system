/* 搜索页面样式 */
.container {
  min-height: 100vh;
  background: #f8f9fa;
}

/* 搜索栏 */
.search-container {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #e9ecef;
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f0f2f5;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 80rpx;
  margin-right: 24rpx;
}

.search-icon {
  margin-right: 16rpx;
  color: #999;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  color: #333;
  background: transparent;
}

.clear-btn {
  font-size: 32rpx;
  color: #999;
  margin-left: 16rpx;
  padding: 8rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
}

.cancel-btn {
  font-size: 32rpx;
  color: #D4A5FF;
  font-weight: 500;
}

/* 历史搜索 */
.history-section {
  padding: 32rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.history-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.clear-history {
  font-size: 28rpx;
  color: #999;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-item {
  padding: 16rpx 24rpx;
  background: #f0f2f5;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #666;
}

/* 热门搜索 */
.hot-section {
  padding: 0 32rpx 32rpx;
}

.hot-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.hot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.hot-item {
  padding: 20rpx 32rpx;
  background: linear-gradient(135deg, #D4A5FF 0%, #B085F5 100%);
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(212, 165, 255, 0.3);
}

/* 搜索中 */
.loading-section {
  padding: 100rpx 0;
  text-align: center;
  font-size: 32rpx;
  color: #999;
}

/* 搜索结果 */
.results-section {
  padding: 32rpx;
}

.result-group {
  margin-bottom: 40rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

/* 摄影师结果 */
.photographer-list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.photographer-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.photographer-item:last-child {
  border-bottom: none;
}

.photographer-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.photographer-info {
  flex: 1;
}

.photographer-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.photographer-specialty {
  font-size: 28rpx;
  color: #999;
}

/* 作品结果 */
.works-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.work-item {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.work-image {
  width: 100%;
  height: 300rpx;
  object-fit: cover;
}

.work-title {
  padding: 16rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 40rpx;
}

/* 无结果 */
.no-results {
  padding: 100rpx 0;
  text-align: center;
  font-size: 32rpx;
  color: #999;
}

/* 动画效果 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.history-section,
.hot-section,
.results-section {
  animation: fadeIn 0.3s ease;
}