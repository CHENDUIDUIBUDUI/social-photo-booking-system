/* 搜索页面样式 */
page {
  background: #f5f5f7;
}

.container {
  min-height: 100vh;
  background: #f5f5f7;
}

/* ===== 搜索栏 ===== */
.search-container {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f2f3f5;
  border-radius: 36rpx;
  padding: 0 28rpx;
  height: 72rpx;
  margin-right: 24rpx;
}

.search-icon {
  margin-right: 14rpx;
  color: #b0b0b0;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 29rpx;
  color: #1a1a1a;
}

.clear-btn {
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 30rpx;
  color: #b0b0b0;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.06);
}

.cancel-btn {
  font-size: 30rpx;
  color: #8B5CF6;
  font-weight: 500;
  padding: 8rpx 0;
}

/* ===== 卡片区域通用 ===== */
.history-section,
.hot-section {
  margin: 24rpx 32rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

/* 标题：左侧紫色色条 + 文字 */
.history-title,
.hot-title,
.result-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.history-title::before,
.hot-title::before,
.result-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #D4A5FF, #8B5CF6);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.hot-title,
.result-title {
  margin-bottom: 24rpx;
}

.clear-history {
  font-size: 26rpx;
  color: #b0b0b0;
  padding: 4rpx 8rpx;
}

/* 历史标签 */
.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.history-item {
  padding: 14rpx 28rpx;
  background: #f5f5f7;
  border-radius: 32rpx;
  font-size: 27rpx;
  color: #555;
}

/* 热门标签 */
.hot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.hot-item {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #D4A5FF 0%, #8B5CF6 100%);
  border-radius: 32rpx;
  font-size: 27rpx;
  color: #fff;
  font-weight: 500;
  box-shadow: 0 6rpx 16rpx rgba(139, 92, 246, 0.28);
}

/* ===== 搜索中 ===== */
.loading-section {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #ececf0;
  border-top-color: #8B5CF6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ===== 搜索结果 ===== */
.results-section {
  padding: 24rpx 32rpx 48rpx;
}

.result-group {
  margin-bottom: 40rpx;
}

/* 摄影师结果 */
.photographer-list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.photographer-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
}

.photographer-item + .photographer-item {
  border-top: 1rpx solid #f2f3f5;
}

.photographer-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: #f2f3f5;
}

.photographer-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.photographer-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.photographer-specialty {
  font-size: 26rpx;
  color: #999;
}

/* 作品网格（flex 两列，真机兼容性优于 grid） */
.works-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.work-item {
  width: 334rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.work-image {
  width: 100%;
  height: 334rpx;
  background: #f2f3f5;
}

.work-title {
  display: block;
  padding: 16rpx 20rpx;
  font-size: 27rpx;
  color: #333;
  line-height: 36rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ===== 无结果 ===== */
.no-results {
  padding: 140rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.no-results-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.no-results-text {
  font-size: 28rpx;
  color: #999;
}

/* ===== 入场动画 ===== */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.history-section,
.hot-section,
.results-section {
  animation: fadeIn 0.3s ease;
}
