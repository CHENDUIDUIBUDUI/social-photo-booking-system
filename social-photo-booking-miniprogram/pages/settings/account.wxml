<!-- 账号与安全页面 -->
<view class="container">
  <view class="header">
    <view class="header-left" bindtap="navigateBack">
      <text class="header-back">←</text>
    </view>
    <view class="header-title">账号与安全</view>
    <view class="header-right"></view>
  </view>
  
  <view class="content">
    <!-- 用户信息 -->
    <view class="user-section">
      <image class="user-avatar" src="{{userInfo.avatar}}"></image>
      <text class="user-name">{{userInfo.nickname}}</text>
    </view>
    
    <!-- 账号设置 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">账号设置</text>
      </view>
      <view class="section-content">
        <view class="setting-item" bindtap="navigateToPhone">
          <text class="setting-label">手机号</text>
          <text class="setting-value">{{userInfo.phone || '未绑定'}}</text>
        </view>
        <view class="setting-item" bindtap="navigateToEmail">
          <text class="setting-label">邮箱</text>
          <text class="setting-value">{{userInfo.email || '未绑定'}}</text>
        </view>
        <view class="setting-item" bindtap="navigateToPassword">
          <text class="setting-label">修改密码</text>
          <text class="setting-arrow">→</text>
        </view>
      </view>
    </view>
    
    <!-- 安全设置 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">安全设置</text>
      </view>
      <view class="section-content">
        <view class="setting-item" bindtap="navigateToLoginDevice">
          <text class="setting-label">登录设备</text>
          <text class="setting-arrow">→</text>
        </view>
        <view class="setting-item" bindtap="navigateToDeleteAccount">
          <text class="setting-label">注销账号</text>
          <text class="setting-arrow">→</text>
        </view>
      </view>
    </view>
  </view>
</view>