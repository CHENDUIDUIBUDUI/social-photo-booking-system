/* 意见反馈页面样式 */

.container {
  flex: 1;
  background-color: #f5f5f5;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  background-color: #fff;
  padding: 0 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.header-left {
  width: 60rpx;
}

.header-back {
  font-size: 40rpx;
  color: #333;
}

.header-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.header-right {
  width: 60rpx;
}

.content {
  flex: 1;
  padding: 20rpx;
}

.form-section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.type-select {
  display: flex;
  gap: 20rpx;
}

.type-item {
  flex: 1;
  padding: 15rpx;
  text-align: center;
  border: 1rpx solid #dcdfe6;
  border-radius: 8rpx;
}

.type-item.active {
  border-color: #1989fa;
  color: #1989fa;
}

.type-text {
  font-size: 26rpx;
}

.form-textarea {
  font-size: 28rpx;
  color: #333;
  width: 100%;
  min-height: 200rpx;
  padding: 15rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 8rpx;
  resize: none;
}

.char-count {
  font-size: 24rpx;
  color: #909399;
  text-align: right;
  margin-top: 10rpx;
}

.form-input {
  font-size: 28rpx;
  color: #333;
  width: 100%;
  padding: 15rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 8rpx;
}

.image-uploader {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-delete {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 30rpx;
  height: 30rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  line-height: 30rpx;
  border-radius: 50%;
}

.image-add {
  width: 150rpx;
  height: 150rpx;
  border: 2rpx dashed #dcdfe6;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #f9f9f9;
}

.image-add-icon {
  font-size: 40rpx;
  color: #909399;
  margin-bottom: 10rpx;
}

.image-add-text {
  font-size: 24rpx;
  color: #909399;
}

.submit-section {
  margin-top: 40rpx;
  padding: 0 20rpx;
}

.submit-button {
  width: 100%;
  height: 80rpx;
  background-color: #1989fa;
  color: #fff;
  font-size: 32rpx;
  border-radius: 8rpx;
}

.submit-button::after {
  border: none;
}