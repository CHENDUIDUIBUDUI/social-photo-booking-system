<!-- 设置页面 -->
<view class="container">
  <view class="header">
    <view class="header-left" bindtap="navigateBack">
      <text class="header-back">←</text>
    </view>
    <view class="header-title">设置</view>
    <view class="header-right"></view>
  </view>
  
  <view class="content">
    <!-- 账号设置 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">账号设置</text>
      </view>
      <view class="section-content">
        <view class="setting-item" bindtap="navigateToAccountSettings">
          <text class="setting-label">账号与安全</text>
          <text class="setting-arrow">→</text>
        </view>
        <view class="setting-item" bindtap="navigateToPrivacySettings">
          <text class="setting-label">隐私设置</text>
          <text class="setting-arrow">→</text>
        </view>
        <view class="setting-item" bindtap="navigateToNotificationSettings">
          <text class="setting-label">通知设置</text>
          <text class="setting-arrow">→</text>
        </view>
      </view>
    </view>
    
    <!-- 通用设置 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">通用设置</text>
      </view>
      <view class="section-content">
        <view class="setting-item" bindtap="clearCache">
          <text class="setting-label">清除缓存</text>
          <text class="setting-value">{{cacheSize}}</text>
        </view>
        <view class="setting-item" bindtap="checkUpdate">
          <text class="setting-label">检查更新</text>
          <text class="setting-value">{{version}}</text>
        </view>
      </view>
    </view>
    
    <!-- 其他 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">其他</text>
      </view>
      <view class="section-content">
        <view class="setting-item" bindtap="navigateToAbout">
          <text class="setting-label">关于我们</text>
          <text class="setting-arrow">→</text>
        </view>
        <view class="setting-item" bindtap="navigateToFeedback">
          <text class="setting-label">意见反馈</text>
          <text class="setting-arrow">→</text>
        </view>
        <view class="setting-item" bindtap="navigateToHelp">
          <text class="setting-label">帮助中心</text>
          <text class="setting-arrow">→</text>
        </view>
      </view>
    </view>
    
    <!-- 退出登录 -->
    <view class="logout-section">
      <button class="logout-button" bindtap="handleLogout">
        退出登录
      </button>
    </view>
  </view>
</view>