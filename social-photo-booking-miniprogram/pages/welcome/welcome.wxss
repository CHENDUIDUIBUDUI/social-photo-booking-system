.container {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #FDFDFD;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.background-blobs {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.4;
}

.blob-1 {
  width: 300px;
  height: 300px;
  background: linear-gradient(135deg, #A8E6CF 0%, #D4A5FF 100%);
  top: -100px;
  left: -100px;
}

.blob-2 {
  width: 250px;
  height: 250px;
  background: linear-gradient(135deg, #D4A5FF 0%, #A8E6CF 100%);
  bottom: -80px;
  right: -80px;
}

.content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 32px;
}

.icon-wrapper {
  width: 120px;
  height: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48px;
  background: linear-gradient(135deg, #A8E6CF 0%, #D4A5FF 100%);
  border-radius: 32px;
  box-shadow: 0 8px 32px rgba(168, 230, 207, 0.3);
}

.camera-icon {
  width: 60px;
  height: 60px;
  filter: brightness(0) invert(1);
}

.title {
  font-size: 32px;
  font-weight: 700;
  line-height: 44px;
  background: linear-gradient(135deg, #A8E6CF 0%, #D4A5FF 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 16px;
  text-align: center;
  letter-spacing: 2px;
}

.slogan {
  font-size: 14px;
  font-weight: 400;
  line-height: 20px;
  color: #868E96;
  margin-bottom: 64px;
  text-align: center;
}

.loading-bar {
  width: 200px;
  height: 4px;
  background: #F1F3F5;
  border-radius: 2px;
  overflow: hidden;
}

.loading-progress {
  height: 100%;
  background: linear-gradient(90deg, #A8E6CF 0%, #D4A5FF 100%);
  border-radius: 2px;
  transition: width 0.1s linear;
}