/* 发布作品页面样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f5f5 0%, #ffffff 100%);
  padding-bottom: 120rpx;
}

/* 顶部导航栏 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 44rpx 32rpx 24rpx;
  background: linear-gradient(135deg, #A8E6CF 0%, #DDA0DD 100%);
  box-sizing: border-box;
}

.header-left {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.header-back {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
}

.header-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: 600;
  text-align: center;
  flex: 1;
}

.header-right {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.header-submit {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

/* 表单容器 */
.form-container {
  padding: 32rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-label {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f8f8f8;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #A8E6CF;
  background: #fff;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  background: #f8f8f8;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-textarea:focus {
  border-color: #A8E6CF;
  background: #fff;
}

/* 单选按钮组 */
.radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.radio-item {
  padding: 16rpx 32rpx;
  background: #f8f8f8;
  border: 2rpx solid #e0e0e0;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s ease;
}

.radio-item.selected {
  background: linear-gradient(135deg, #A8E6CF 0%, #DDA0DD 100%);
  border-color: transparent;
  color: #fff;
  font-weight: 500;
}

.radio-text {
  font-size: 28rpx;
}

/* 多选按钮组 */
.checkbox-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.checkbox-item {
  padding: 16rpx 32rpx;
  background: #f8f8f8;
  border: 2rpx solid #e0e0e0;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s ease;
}

.checkbox-item.selected {
  background: linear-gradient(135deg, #A8E6CF 0%, #DDA0DD 100%);
  border-color: transparent;
  color: #fff;
  font-weight: 500;
}

.checkbox-text {
  font-size: 28rpx;
}

/* 拍摄参数 */
.params-container {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.param-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.param-label {
  width: 100rpx;
  font-size: 28rpx;
  color: #666;
}

.param-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: #f8f8f8;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #333;
  box-sizing: border-box;
}

.param-input:focus {
  border-color: #A8E6CF;
  background: #fff;
}

/* 图片上传 */
.image-uploader {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ccc;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8f8f8;
}

.image-add-icon {
  font-size: 64rpx;
  margin-bottom: 8rpx;
}

.image-add-text {
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

/* 底部按钮 */
.bottom-button {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  z-index: 100;
}

.submit-button {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #A8E6CF 0%, #DDA0DD 100%);
  border: none;
  border-radius: 44rpx;
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(168, 230, 207, 0.3);
}

.submit-button::after {
  border: none;
}